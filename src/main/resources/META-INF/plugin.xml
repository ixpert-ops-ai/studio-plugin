<idea-plugin>
    <id>net.ib.ixpert.ops.wuwagent</id>
    <name>iXpert AI Assistant</name>
    <vendor email="admin@jodongik.cloud" url="http://jodongik.cloud">Jodongik Cloud</vendor>
    <description><![CDATA[
      iXpert AI Assistant is an on-premise AI Coding Assistant plugin powered by Ollama.
      Provides code explain, review, refactoring, PMD analysis, Impact Analysis, and Generate Test.
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         See: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Add your extensions here -->
        <!-- ToolWindow Example: WuwAgent Chat window -->
        <toolWindow id="iXpert AI Assistant"
                    anchor="right"
                    icon="AllIcons.General.Robot"
                    factoryClass="net.ib.ixpert.ops.wuwagent.ui.WuwToolWindowFactory"/>
                    
        <notificationGroup id="WhatUWantNotification"
                           displayType="BALLOON"
                           key="WhatUWantNotification" />
                           
        <applicationService serviceImplementation="net.ib.ixpert.ops.wuwagent.setting.SettingsState"/>
        
        <applicationConfigurable instance="net.ib.ixpert.ops.wuwagent.setting.WuwSettingsConfigurable"
                                 id="net.ib.ixpert.ops.wuwagent.setting.WuwSettingsConfigurable"
                                 displayName="iXpert AI Assistant"
                                 parentId="tools"/>
    </extensions>

    <actions>
        <!-- iXpert AI Assistant 컨텍스트 메뉴 그룹 -->
        <group id="IxpertAiAssistant.EditorGroup"
               text="iXpert AI Assistant"
               description="iXpert AI Assistant actions"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>

            <action id="IxpertAiAssistant.ExplainAction"
                    class="net.ib.ixpert.ops.wuwagent.action.ExplainAction"
                    text="Explain This Code (코드 설명)"
                    description="선택한 코드를 AI가 분석/설명합니다."/>

            <action id="IxpertAiAssistant.ReviewAction"
                    class="net.ib.ixpert.ops.wuwagent.action.ReviewAction"
                    text="Review This Code (코드 리뷰)"
                    description="선택한 코드를 AI가 리뷰합니다."/>

            <action id="IxpertAiAssistant.ImpactAnalysisAction"
                    class="net.ib.ixpert.ops.wuwagent.action.ImpactAnalysisAction"
                    text="Impact Analysis (영향도 분석)"
                    description="선택한 코드의 변경 영향 범위를 AI가 분석합니다."/>

            <action id="IxpertAiAssistant.QueryValidationAction"
                    class="net.ib.ixpert.ops.wuwagent.action.QueryValidationAction"
                    text="Query Validation (쿼리 검증)"
                    description="선택한 쿼리를 AI가 유효성 검증합니다."/>

            <action id="IxpertAiAssistant.ImproveAction"
                    class="net.ib.ixpert.ops.wuwagent.action.ImproveAction"
                    text="Improve This Code (코드 개선)"
                    description="선택한 코드를 AI가 개선합니다."/>

            <action id="IxpertAiAssistant.GenerateTestAction"
                    class="net.ib.ixpert.ops.wuwagent.action.GenerateTestAction"
                    text="Generate Test (테스트 생성)"
                    description="선택한 코드의 단위 테스트를 AI가 생성합니다."/>
        </group>
    </actions>
</idea-plugin>
