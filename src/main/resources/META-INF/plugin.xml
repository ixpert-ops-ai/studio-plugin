<idea-plugin>
    <id>net.ib.ixpert.ops.wuwagent</id>
    <name>iXpert AI Assistant</name>
    <vendor email="admin@jodongik.cloud" url="http://jodongik.cloud">IB iXpert Ops</vendor>
    <description><![CDATA[
iXpert AI Assistant is an on-premise AI Coding Assistant plugin powered by vLLM (OpenAI-compatible API).
Provides code explain, improve, impact analysis, query validation, unit test report, document generation, and project MetaGraph analysis.
Supports Android and Spring-based projects with framework-aware AI responses.

iXpert AI Assistant는 vLLM 기반 사내 AI 코딩 어시스턴트 플러그인입니다.
코드 설명, 개선, 영향도 분석, 쿼리 검증, 단위 테스트 리포트, 문서 생성, 프로젝트 MetaGraph 분석 기능을 제공합니다.
Android 및 Spring 프로젝트의 프레임워크를 자동 감지하여 맞춤형 AI 응답을 제공합니다.
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         See: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Add your extensions here -->
        <!-- ToolWindow Example: WuwAgent Chat window -->
        <toolWindow id="iXpert AI Assistant"
                    anchor="right"
                    icon="net.ib.ixpert.ops.wuwagent.IxpertIcons.ToolWindow"
                    factoryClass="net.ib.ixpert.ops.wuwagent.ui.WuwToolWindowFactory"/>
                    
        <notificationGroup id="WhatUWantNotification"
                           displayType="BALLOON"
                           key="WhatUWantNotification" />
                           
        <applicationService serviceImplementation="net.ib.ixpert.ops.wuwagent.setting.SettingsState"/>
        <applicationService serviceImplementation="net.ib.ixpert.ops.wuwagent.service.DebugManager"/>

        <toolWindow id="LLM Debug"
                    anchor="bottom"
                    secondary="true"
                    factoryClass="net.ib.ixpert.ops.wuwagent.ui.LlmDebugToolWindowFactory"/>

        <applicationConfigurable instance="net.ib.ixpert.ops.wuwagent.setting.WuwSettingsConfigurable"
                                 id="net.ib.ixpert.ops.wuwagent.setting.WuwSettingsConfigurable"
                                 displayName="iXpert AI Assistant"
                                 parentId="tools"/>
        <postStartupActivity implementation="net.ib.ixpert.ops.wuwagent.service.metagraph.analyzer.AnyframeDetector"/>

        <!-- 최초 실행 시 웰컴 다이얼로그 표시 (isFirstRun=true 인 경우에만 동작) -->
        <postStartupActivity implementation="net.ib.ixpert.ops.wuwagent.startup.FirstRunStartupActivity"/>
    </extensions>

    <actions>
        <!-- iXpert AI Assistant 컨텍스트 메뉴 그룹 -->
        <group id="IxpertAiAssistant.EditorGroup"
               text="iXpert AI Assistant"
               description="iXpert AI Assistant actions"
               popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>

            <action id="IxpertAiAssistant.ExplainAction"
                    class="net.ib.ixpert.ops.wuwagent.action.ExplainAction"
                    text="Explain This Code (코드 설명)"
                    description="선택한 코드를 AI가 분석/설명합니다."/>

            <action id="IxpertAiAssistant.ImpactAnalysisAction"
                    class="net.ib.ixpert.ops.wuwagent.action.ImpactAnalysisAction"
                    text="Impact Analysis (영향도 분석)"
                    description="선택한 코드의 변경 영향 범위를 AI가 분석합니다."/>

            <action id="IxpertAiAssistant.QueryValidationAction"
                    class="net.ib.ixpert.ops.wuwagent.action.QueryValidationAction"
                    text="Query Validation (쿼리 검증)"
                    description="선택한 쿼리를 AI가 유효성 검증합니다."/>

            <action id="IxpertAiAssistant.ImproveAction"
                    class="net.ib.ixpert.ops.wuwagent.action.ImproveAction"
                    text="Improve This Code (코드 개선)"
                    description="선택한 코드를 AI가 개선합니다."/>

            <action id="IxpertAiAssistant.DocGenerateAction"
                    class="net.ib.ixpert.ops.wuwagent.action.DocGenerateAction"
                    text="Generate Analysis Doc (분석 문서 생성)"
                    description="현재 파일의 AI 분석 결과를 Markdown 문서로 저장합니다."/>

            <action id="IxpertAiAssistant.UnitTestReportAction"
                    class="net.ib.ixpert.ops.wuwagent.action.UnitTestReportAction"
                    text="Generate Unit Test Report (단위 테스트 리포트)"
                    description="선택한 코드의 단위 테스트 리포트를 AI가 생성합니다."/>
        </group>

        <!-- Project View 컨텍스트 메뉴 그룹 -->
        <group id="IxpertAiAssistant.ProjectViewGroup"
               text="iXpert AI Assistant"
               description="iXpert AI Assistant actions"
               popup="true">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>

            <action id="IxpertAiAssistant.MetaGraphAction"
                    class="net.ib.ixpert.ops.wuwagent.action.MetaGraphAction"
                    text="Generate Project MetaGraph"
                    description="전체 프로젝트를 분석하여 메타그래프(project-graph.json)를 갱신합니다."/>
        </group>
    </actions>
</idea-plugin>
